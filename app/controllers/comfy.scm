(define* (reply value #:optional (status 200))
  (response-emit (json-encode value)
                 #:status status
                 #:headers '((content-type . (application/json (charset . "utf-8"))))))
(define (obj . fields) (make-json-object fields))
(define (server-features)
  (obj (cons "supports_preview_metadata" #f)
       (cons "supports_model_type_tags" #f)
       (cons "max_upload_size" 104857600)
       (cons "extension" (obj (cons "manager" (obj (cons "supports_v4" #f)))))
       (cons "node_replacements" #f)
       (cons "assets" #f)
       (cons "deploy_to_cloud" #f)))
(define (ensure-directory path)
  (unless (file-exists? path)
    (let ((parent (dirname path)))
      (unless (or (string=? parent path) (string=? parent "."))
        (ensure-directory parent))
      (mkdir path #o755))))
(define (safe-user-path config relative)
  (and (string? relative) (not (string-prefix? "/" relative))
       (not (member ".." (string-split relative #\/)))
       (let* ((root0 (config-ref config 'user_dir))
              (root (canonicalize-path root0))
              (candidate (string-append root "/" relative))
              (resolved (if (file-exists? candidate)
                            (canonicalize-path candidate)
                            (let ((parent (dirname candidate)))
                              (if (file-exists? parent)
                                  (string-append (canonicalize-path parent) "/"
                                                 (basename candidate))
                                  candidate))))
              (prefix (string-append root "/")))
         (and (or (string=? resolved root)
                  (string-prefix? prefix resolved))
              resolved))))
(define (read-user-json config name)
  (let ((path (safe-user-path config name)))
    (if (and path (file-exists? path))
        (guard (ex (#t (obj)))
          (json-normalize
           (json-string->scm (call-with-input-file path get-string-all))))
        (obj))))
(define (write-user-json config name value)
  (let ((path (safe-user-path config name)))
    (unless path (error "invalid user data path" name))
    (ensure-directory (dirname path))
    (call-with-output-file path (lambda (port) (display (json-encode value) port)))))
(define (set-json-field fields name value)
  (cons (cons name value)
        (filter (lambda (entry) (not (equal? (car entry) name))) fields)))
(define (safe-user-files config relative)
  (let ((path (safe-user-path config relative)))
    (and path (file-exists? path)
         (if (file-is-directory? path)
             (scandir path (lambda (name) (not (member name '("." "..")))))
             '()))))
(define (user-root config)
  (canonicalize-path (config-ref config 'user_dir)))
(define (relative-user-path root path)
  (let ((prefix (string-append root "/")))
    (if (and (string-prefix? prefix path) (< (string-length prefix) (string-length path)))
        (substring path (string-length prefix))
        (basename path))))
(define (stat-milliseconds seconds nanoseconds)
  (+ (* seconds 1000) (quotient (or nanoseconds 0) 1000000)))
(define (user-file-info root path)
  (let* ((st (stat path))
         (relative (relative-user-path root path))
         (base (list (cons "path" relative)
                     (cons "size" (stat:size st))
                     (cons "modified"
                           (stat-milliseconds (stat:mtime st)
                                              (stat:mtimensec st)))
                     (cons "created"
                           (stat-milliseconds (stat:ctime st)
                                              (stat:ctimensec st))))))
    (apply obj base)))
(define (walk-files directory recurse?)
  (let loop ((names (scandir directory
                              (lambda (name) (not (member name '("." ".."))))))
             (files '()))
    (if (null? names)
        (reverse files)
        (let* ((name (car names))
               (path (string-append directory "/" name)))
          (loop (cdr names)
                (if (file-is-directory? path)
                    (if recurse?
                        (append (reverse (walk-files path #t)) files)
                        files)
                    (cons path files)))))))
(define (walk-user-entries root directory)
  (let loop ((names (scandir directory
                              (lambda (name) (not (member name '("." ".."))))))
             (entries '()))
    (if (null? names)
        entries
        (let* ((name (car names))
               (path (string-append directory "/" name))
               (relative (relative-user-path root path))
               (directory? (file-is-directory? path))
               (entry
                (if directory?
                    (obj (cons "name" name) (cons "path" relative)
                         (cons "type" "directory"))
                    (let* ((st (stat path))
                           (fields
                            (list (cons "name" name) (cons "path" relative)
                                  (cons "type" "file")
                                  (cons "size" (stat:size st))
                                  (cons "modified" (stat:mtime st)))))
                      (apply obj fields)))))
          (loop (cdr names)
                (append (if directory?
                            (walk-user-entries root path)
                            '())
                        (cons entry entries)))))))
(define (entry-field entry key)
  (assoc-ref (json-object-fields entry) key))
(define (sort-user-entries entries)
  (sort entries
        (lambda (left right)
          (let ((left-directory (string=? (entry-field left "type") "directory"))
                (right-directory (string=? (entry-field right "type") "directory"))
                (left-name (entry-field left "name"))
                (right-name (entry-field right "name")))
            (cond ((and left-directory (not right-directory)) #t)
                  ((and right-directory (not left-directory)) #f)
                  (else (string-ci<? left-name right-name)))))))
(define (raw-query-param rc key)
  (let* ((query (uri-query (request-uri (rc-req rc))))
         (entry (and query
                     (find (lambda (part)
                             (let ((equals (string-index part #\=)))
                               (and equals
                                    (string=? (substring part 0 equals) key))))
                           (string-split query #\&)))))
    (and entry
         (let ((equals (string-index entry #\=)))
           (uri-decode (substring entry (+ equals 1)))))))
(define (request-param rc key)
  (or (params rc key) (raw-query-param rc key)))
(define (request-flag? rc key)
  (let ((value (request-param rc key)))
    (and (string? value)
         (string=? (string-downcase value) "true"))))
(define (safe-file-component? value)
  (and (string? value) (not (string-null? value))
       (not (string-prefix? "/" value))
       (not (member ".." (string-split value #\/)))
       (not (string-contains value "\\"))))
(define (upload-directory config type subfolder)
  (and (member type '("input" "temp" "output"))
       (or (string-null? subfolder) (safe-file-component? subfolder))
       (string-append (file-root config type)
                      (if (string-null? subfolder) ""
                          (string-append "/" subfolder)))))
(define (increment-name filename index)
  (let ((dot (string-rindex filename #\.)))
    (if (and dot (> dot 0))
        (string-append (substring filename 0 dot) " (" (number->string index) ")"
                       (substring filename dot))
        (string-append filename " (" (number->string index) ")"))))
(define (operator-field rc operator name)
  (let ((part (find (lambda (mfd) (equal? (mfd-name mfd) name))
                    (mfds-operator-mfds operator))))
    (and part (mfds-op-ref rc operator name))))
(define (store-upload! config rc)
  (let* ((operator (get-mfds-op-from-post rc))
         (file-part (find (lambda (part) (and (mfd-filename part)
                                              (equal? (mfd-name part) "image")))
                          (mfds-operator-mfds operator)))
         (field (lambda (name)
                  (operator-field rc operator name)))
         (raw-filename (and file-part (mfd-filename file-part)))
         (filename (and raw-filename (basename raw-filename)))
         (type (or (field "type") "input"))
         (subfolder (or (field "subfolder") ""))
         (overwrite (member (field "overwrite") '("true" "1")))
         (directory (and filename (upload-directory config type subfolder)))
         (bytes (and file-part (mfds-op-ref rc operator "image" #:bv? #t))))
    (unless (and file-part filename (equal? filename raw-filename)
                 (safe-file-component? filename) directory bytes)
      (throw 'artanis-err 400 store-upload! "Invalid multipart image upload"))
    (ensure-directory directory)
    (let loop ((name filename) (index 1))
      (let ((path (string-append directory "/" name)))
        (cond
         ((not (file-exists? path))
          (call-with-output-file path (lambda (port) (put-bytevector port bytes)))
          (values name #f type subfolder))
         (overwrite
          (call-with-output-file path (lambda (port) (put-bytevector port bytes)))
          (values name #f type subfolder))
         ((equal? (call-with-input-file path get-bytevector-all) bytes)
          (values name #t type subfolder))
         (else (loop (increment-name filename index) (+ index 1))))))))
(define (store-mask! config rc)
  (let* ((operator (get-mfds-op-from-post rc))
         (mask-part (find (lambda (part) (and (mfd-filename part)
                                              (equal? (mfd-name part) "image")))
                          (mfds-operator-mfds operator)))
         (original-ref-text (operator-field rc operator "original_ref"))
         (original-ref (and original-ref-text (json-string->scm original-ref-text)))
         (filename (and (list? original-ref) (assoc-ref original-ref "filename")))
         (subfolder (or (and (list? original-ref) (assoc-ref original-ref "subfolder")) ""))
         (type (or (and (list? original-ref) (assoc-ref original-ref "type")) "input"))
         (path (and filename (view-path config filename subfolder type)))
         (mask-bytes (and mask-part (mfds-op-ref rc operator "image" #:bv? #t))))
    (unless (and path mask-bytes)
      (throw 'artanis-err 400 store-mask! "Invalid mask upload or original_ref"))
    (let* ((original (call-with-input-file path get-bytevector-all))
           (combined (png-mask-composite original mask-bytes)))
      (call-with-output-file path (lambda (port) (put-bytevector port combined)))
      (values filename subfolder type))))
(define (new-prompt-id)
  (call-with-input-file "/proc/sys/kernel/random/uuid" read-line))
(define (broadcast-queue-status!)
  (ws-broadcast!
   (obj (cons "type" "status")
        (cons "data"
              (obj (cons "status"
                         (obj (cons "exec_info"
                                    (obj (cons "queue_remaining"
                                               (+ (length (queue-list))
                                                  (if (queue-current) 1 0))))))))))))

(define (queue-render item)
  (if item
      (list (assq-ref item 'number) (assq-ref item 'prompt_id)
            (json-normalize (assq-ref item 'prompt))
            (make-json-object
             (list (cons "client_id" (or (assq-ref item 'client_id) 'null)))))
      '()))

(define (all-history config)
  (let ((memory (history-all))
        (stored (or (persistence-call config 'fetch-all-history!) '())))
    (append memory (filter (lambda (entry) (not (assoc (car entry) memory))) stored))))

(define (register-routes! config)
  (define (install prefix)
    (define (route path handler) (get (string-append prefix path) handler))
    (route "/object_info" (lambda _ (reply (make-json-object (object-info config)))))
    (route "/object_info/:node" (lambda (rc)
                                    (reply (make-json-object
                                            (object-info config (params rc "node"))))))
    (get (string-append prefix "/ws") #:websocket 'raw
         (lambda (rc)
           (let ((sid (or (params rc "clientId") (new-prompt-id))))
             (ws-dispatcher
              #:on-open
              (lambda (connection)
                (catch #t
                  (lambda ()
                    (ws-register! sid connection)
                    (ws-send connection
                      (json-encode
                       (obj (cons "type" "status")
                            (cons "data"
                                  (obj (cons "status"
                                             (obj (cons "exec_info"
                                                        (obj (cons "queue_remaining"
                                                                   (length (queue-list)))))))
                                       (cons "sid" sid)))))))
                  (lambda (key . args)
                    (format (current-error-port) "Khala WebSocket open error: ~s ~s~%"
                            key args)
                    (apply throw key args))))
              #:on-message
              (lambda (connection message)
                (when (ws-message-text? message)
                  (let* ((parsed (json-string->scm (ws-message-text message)))
                         (type (and (list? parsed) (assoc-ref parsed "type"))))
                    (when (equal? type "feature_flags")
                      (ws-send connection
                        (json-encode (obj (cons "type" "feature_flags")
                                          (cons "data" (server-features)))))))
                #t))
              #:on-close (lambda (_connection _code _reason)
                           (ws-unregister! sid))))))
    (route "/models" (lambda _ (reply model-folders)))
    (for-each
     (lambda (folder)
       (route (string-append "/models/" folder)
              (lambda _ (reply (model-files config folder))))
       (route (string-append "/models-type/" folder)
              (lambda _ (reply (model-files config folder)))))
     model-folders)
    (route "/users" (lambda _ (reply (obj (cons "storage" "server")
                                           (cons "migrated" #f)))))
    (route "/settings" (lambda _ (reply (read-user-json config "comfy.settings.json"))))
    (post (string-append prefix "/settings")
          (lambda (rc)
            (let* ((body (rc-body rc))
                   (incoming (if body
                                 (json-normalize
                                  (json-string->scm (utf8->string body)))
                                 (obj)))
                   (current (read-user-json config "comfy.settings.json"))
                   (fields (append (if (json-object? current)
                                       (json-object-fields current) '())
                                   (if (json-object? incoming)
                                       (json-object-fields incoming) '())))
                   (merged (make-json-object
                            (fold (lambda (entry out)
                                    (set-json-field out (car entry) (cdr entry)))
                                  '() fields))))
              (write-user-json config "comfy.settings.json" merged)
              (reply (obj)))))
    (route "/settings/:id"
           (lambda (rc)
             (let* ((settings (read-user-json config "comfy.settings.json"))
                    (entry (and (json-object? settings)
                                (assoc (params rc "id") (json-object-fields settings)))))
               (reply (if entry (cdr entry) 'null)))))
    (post (string-append prefix "/settings/:id")
          (lambda (rc)
            (let* ((id (params rc "id"))
                   (body (rc-body rc))
                   (value (if body
                              (json-normalize
                               (json-string->scm (utf8->string body)))
                              'null))
                   (current (read-user-json config "comfy.settings.json"))
                   (fields (if (json-object? current) (json-object-fields current) '()))
                   (updated (make-json-object
                             (set-json-field fields id value))))
              (write-user-json config "comfy.settings.json" updated)
              (reply (obj)))))
    (route "/extensions" (lambda _ (reply '())))
    (route "/embeddings" (lambda _ (reply '())))
    (route "/features" (lambda _ (reply (server-features))))
    (route "/prompt" (lambda _ (reply (obj (cons "exec_info"
                                    (obj (cons "queue_remaining" (length (queue-list)))))))))
    (route "/system_stats" (lambda _ (reply (obj (cons "system" (obj))
                                                   (cons "devices" '())))))
    (route "/queue" (lambda _ (reply (obj
                          (cons "queue_running" (if (queue-current)
                                                    (list (queue-render (queue-current))) '()))
                          (cons "queue_pending" (map queue-render (queue-list)))))))
    (route "/history"
           (lambda _ (reply (make-json-object (all-history config)))))
    (route "/history/:prompt_id"
           (lambda (rc)
             (let* ((id (params rc "prompt_id"))
                    (record (or (history-ref id)
                                (persistence-call config 'fetch-history id))))
               (reply (if record
                          (make-json-object (list (cons id record)))
                          (obj))))))
    (route "/" (lambda _
                  (let ((index "vendor/comfyui-frontend/index.html"))
                    (if (file-exists? index)
                        (response-emit (call-with-input-file index get-bytevector-all)
                                       #:headers '((content-type . (text/html (charset . "utf-8")))))
                        (response-emit "ComfyUI-compatible Khala server")))))
    (when (string-null? prefix)
      (route "/user.css" (lambda _ (response-emit "" #:headers '((content-type . (text/css))))))
      (route "/materialdesignicons.min.css"
             (lambda _ (response-emit "" #:headers '((content-type . (text/css))))))
      (route "/api/userdata/user.css"
             (lambda _ (response-emit "" #:headers '((content-type . (text/css)))))))
    (post (string-append prefix "/prompt")
          (lambda (rc)
            (let* ((body (rc-body rc))
                   (request (and body (json-string->scm (utf8->string body))))
                   (prompt-pair (and (list? request) (assoc "prompt" request)))
                   (prompt (and prompt-pair (cdr prompt-pair))))
              (if (not prompt)
                  (reply (obj (cons "error" (obj
                               (cons "type" "no_prompt")
                               (cons "message" "No prompt provided")
                               (cons "details" "No prompt provided")
                               (cons "extra_info" (obj))))
                             (cons "node_errors" (obj))) 400)
                  (call-with-values
                      (lambda () (validate-prompt config prompt))
                    (lambda (valid? details)
                      (if (not valid?)
                          (reply details 400)
                          (let* ((id (new-prompt-id))
                                 (client (and (assoc "client_id" request)
                                              (cdr (assoc "client_id" request))))
                                 (number (comfy-next-prompt-number!)))
                            (let* ((extra (or (and (assoc "extra_data" request)
                                                   (cdr (assoc "extra_data" request))) '()))
                                   (item `((prompt_id . ,id)
                                           (number . ,number)
                                           (client_id . ,client)
                                           (extra_data . ,extra)
                                           (prompt . ,prompt)))
                                   (front? (eq? #t (and (assoc "front" request)
                                                       (cdr (assoc "front" request))))))
                              (persistence-call config 'save-queue-item! item front?)
                              (queue-submit! item front?)
                              (broadcast-queue-status!))
                            (reply (obj (cons "prompt_id" id)
                                        (cons "number" number)
                                        (cons "node_errors" (obj))))))))))))
    (post (string-append prefix "/queue")
          (lambda _ (queue-clear!)
            (persistence-call config 'clear-persisted-queue!)
            (broadcast-queue-status!) (reply (obj))))
    (page-delete (string-append prefix "/queue")
                 (lambda _ (queue-clear!)
                   (persistence-call config 'clear-persisted-queue!)
                   (broadcast-queue-status!) (reply (obj))))
    (route "/interrupt" (lambda _ (queue-interrupt!) (reply (obj))))
    (post (string-append prefix "/interrupt")
          (lambda _ (queue-interrupt!) (reply (obj))))
    (route "/view"
           (lambda (rc)
             (let ((path (view-path config (params rc "filename")
                                   (params rc "subfolder") (params rc "type"))))
               (if path
                   (response-emit (call-with-input-file path get-bytevector-all)
                                  #:headers '((content-type . (image/png))))
                   (response-emit "Not found" #:status 404)))))
    (route "/userdata"
           (lambda (rc)
             (let* ((dir (params rc "dir"))
                    (path (and dir (not (string-null? dir))
                               (safe-user-path config dir))))
               (cond
                ((or (not dir) (string-null? dir))
                 (response-emit "Directory not provided" #:status 400))
                ((not path)
                 (response-emit "Invalid directory" #:status 403))
                ((not (file-exists? path))
                 (response-emit "Directory not found" #:status 404))
                ((not (file-is-directory? path))
                 (response-emit "Requested path is not a directory" #:status 400))
                (else
                 (let* ((root (user-root config))
                        (recurse? (request-flag? rc "recurse"))
                        (full-info? (request-flag? rc "full_info"))
                        (split? (request-flag? rc "split"))
                        (files (walk-files path recurse?)))
                   (reply
                    (map (lambda (file)
                           (let ((relative (relative-user-path path file)))
                             (cond
                              (full-info? (user-file-info path file))
                              (split?
                               (cons relative
                                     (string-split relative #\/)))
                              (else relative))))
                         files))))))))
    (route "/v2/userdata"
           (lambda (rc)
             (let* ((path (or (params rc "path") ""))
                    (root (user-root config))
                    (target (safe-user-path config path)))
               (cond
                ((not target)
                 (response-emit "Invalid path requested" #:status 400))
                ((not (file-exists? target))
                 (if (string-null? path)
                     (reply '())
                     (response-emit "Requested path not found" #:status 404)))
                ((not (file-is-directory? target))
                 (response-emit "Requested path is not a directory" #:status 400))
                (else
                 (reply (sort-user-entries
                         (walk-user-entries root target))))))))
    (get (string-append prefix "/userdata/:file")
         (lambda (rc)
           (let ((path (safe-user-path config (params rc "file"))))
             (if (and path (file-exists? path))
                 (response-emit (call-with-input-file path get-bytevector-all))
                 (response-emit "Not found" #:status 404)))))
    (post (string-append prefix "/userdata/:file")
          (lambda (rc)
            (let ((path (safe-user-path config (params rc "file")))
                  (body (rc-body rc))
                  (overwrite? (not (equal? (request-param rc "overwrite") "false")))
                  (full-info? (request-flag? rc "full_info")))
              (cond
               ((not (and path body))
                (response-emit "Invalid user data path" #:status 400))
               ((and (file-exists? path) (not overwrite?))
                (response-emit "File already exists" #:status 409))
               (else
                (ensure-directory (dirname path))
                (call-with-output-file path
                  (lambda (port) (put-bytevector port body)))
                (reply (if full-info?
                           (user-file-info (user-root config) path)
                           (relative-user-path (user-root config) path))))))))
    (page-delete (string-append prefix "/userdata/:file")
                 (lambda (rc)
                   (let ((path (safe-user-path config (params rc "file"))))
                     (if (and path (file-exists? path))
                         (begin (delete-file path)
                                (response-emit "" #:status 204))
                         (response-emit "Not found" #:status 404)))))
    (post (string-append prefix "/userdata/:file/move/:dest")
          (lambda (rc)
            (let* ((source (safe-user-path config (params rc "file")))
                   (dest (safe-user-path config (params rc "dest")))
                   (overwrite? (not (equal? (request-param rc "overwrite") "false")))
                   (full-info? (request-flag? rc "full_info")))
              (cond
               ((not (and source dest (file-exists? source)))
                (response-emit "Invalid user data path" #:status 400))
               ((and (file-exists? dest) (not overwrite?))
                (response-emit "Destination already exists" #:status 409))
               (else
                (ensure-directory (dirname dest))
                (when (and overwrite? (file-exists? dest)) (delete-file dest))
                (rename-file source dest)
                (reply (if full-info?
                           (user-file-info (user-root config) dest)
                           (relative-user-path (user-root config) dest))))))))
    (route "/internal/folder_paths"
           (lambda _ (reply (make-json-object
                              (map (lambda (folder)
                                     (cons folder (list (model-path config folder))))
                                   model-folders)))))
    (route "/internal/files/:directory_type"
           (lambda (rc)
             (let* ((type (params rc "directory_type"))
                    (directory (file-root config type)))
               (reply (if (and directory (file-exists? directory))
                          (map (lambda (name) (string-append name " [" type "]"))
                               (scandir directory (lambda (name)
                                 (not (member name '("." ".."))))))
                          '())))))
    (route "/internal/logs" (lambda _ (response-emit "" #:headers '((content-type . (text/plain))))))
    (route "/internal/logs/raw" (lambda _ (reply (obj (cons "entries" '())
                                                       (cons "size" (obj (cons "cols" 80)
                                                                         (cons "rows" 24)))))))
    (post (string-append prefix "/upload/image")
          (lambda (rc)
            (catch #t
              (lambda ()
                (call-with-values
                    (lambda () (store-upload! config rc))
                  (lambda (name duplicate type subfolder)
                    (reply (apply obj
                                  (append (list (cons "name" name)
                                                (cons "subfolder" subfolder)
                                                (cons "type" type))
                                          (if duplicate
                                              (list (cons "duplicate" #t)) '())))))))
              (lambda (key . args)
                (format (current-error-port) "Khala image upload failed: ~s ~s~%"
                        key args)
                (display-backtrace (make-stack #t) (current-error-port))
                (force-output (current-error-port))
                (reply (obj (cons "error"
                                  (obj (cons "type" "invalid_image_upload")
                                       (cons "message" (format #f "~s" args))
                                       (cons "extra_info" (obj)))))
                       400)))))
    (post (string-append prefix "/upload/mask")
          (lambda (rc)
            (catch #t
              (lambda ()
                (call-with-values
                    (lambda () (store-mask! config rc))
                  (lambda (name subfolder type)
                    (reply (obj (cons "name" name) (cons "subfolder" subfolder)
                                (cons "type" type))))))
              (lambda (_key . args)
                (reply (obj (cons "error"
                                  (obj (cons "type" "invalid_mask_png")
                                       (cons "message" (format #f "~s" args))
                                       (cons "details" "Mask must be an 8-bit RGB or RGBA PNG with stored deflate data")
                                       (cons "extra_info" (obj)))))
                       400)))))
  )
  (install "")
  (install "/api"))

(register-routes! (comfy-config))
