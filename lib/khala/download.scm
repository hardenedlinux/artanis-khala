(define-module (khala download)
  #:use-module (curl)
  #:use-module (ice-9 exceptions)
  #:use-module (ice-9 ftw)
  #:use-module (ice-9 format)
  #:use-module (ice-9 popen)
  #:use-module (ice-9 rdelim)
  #:use-module (ice-9 threads)
  #:use-module (json)
  #:use-module (rnrs io ports)
  #:use-module (rnrs bytevectors)
  #:use-module (srfi srfi-1)
  #:use-module (srfi srfi-9)
  #:use-module (srfi srfi-13)
  #:use-module (srfi srfi-34)
  #:use-module (khala config)
  #:use-module (khala json)
  #:export (start-download-job job-status cancel-job! set-download-config!
            list-repo-files start-directory-job directory-job-status
            cancel-directory-job! directory-job?
            download-range-to-fd download-head-size))

(define download-config (load-config))
(define (set-download-config! config) (set! download-config config))
(define (cfg key) (or (config-ref download-config key)
                      (config-ref (load-config) key)))
(define (ref alist key . default)
  (let* ((name (if (symbol? key) (symbol->string key) key))
         (entry (and (list? alist) (or (assq key alist) (assoc name alist)))))
    (if entry (cdr entry) (if (null? default) #f (car default)))))
(define (sym x) (if (symbol? x) x (string->symbol x)))
(define (name x) (if (symbol? x) (symbol->string x) x))
(define (trim-slashes s)
  (let loop ((n (string-length s)))
    (if (and (> n 0) (char=? (string-ref s (- n 1)) #\/))
        (loop (- n 1)) (substring s 0 n))))
(define (safe-relative? p)
  (and (string? p) (not (string-prefix? "/" p))
       (not (member ".." (string-split p #\/)))))
(define (find-map proc items)
  (let loop ((items items))
    (if (null? items) #f
        (let ((value (proc (car items))))
          (if value value (loop (cdr items)))))))
(define (ensure-parent path)
  (let ((dir (dirname path)))
    (let make ((current dir))
      (unless (or (string=? current ".") (string=? current "/")
                  (file-exists? current))
        (make (dirname current))
        (mkdir current #o755)))))


(define-record-type <download-job>
  (make-job entry dest final part sidecar size chunk-size sources state error
            cancelled? verified? complete pending active handles lock thread samples
            total speed source started bytes-seen)
  job?
  (entry job-entry) (dest job-dest) (final job-final) (part job-part)
  (sidecar job-sidecar) (size job-size set-size!)
  (chunk-size job-chunk-size) (sources job-sources set-sources!)
  (state job-state set-state!) (error job-error set-error!)
  (cancelled? job-cancelled? set-cancelled!) (verified? job-verified? set-verified!)
  (complete job-complete set-complete!) (pending job-pending set-pending!)
  (active job-active set-active!) (handles job-handles set-handles!)
  (lock job-lock) (thread job-thread set-thread!) (samples job-samples set-samples!)
  (total job-total set-total!) (speed job-speed set-speed!) (source job-source set-source!)
  (started job-started) (bytes-seen job-bytes-seen set-bytes-seen!))


(define (source-url source path)
  (let* ((kind (sym (car source))) (spec (cdr source))
         (path (or path ""))
         (repo (or (ref spec 'repo) ""))
         (rev (or (ref spec 'revision) "main"))
         (base (or (ref spec 'base_url)
                   (and (not (memq kind '(huggingface hf-mirror modelscope url)))
                        (config-ref download-config
                          (string->symbol (string-append "custom_mirror." (name kind))))))))
    (case kind
      ((huggingface) (string-append (trim-slashes (or base "https://huggingface.co"))
                                    "/" repo "/resolve/" rev "/" path))
      ((hf-mirror) (string-append (trim-slashes (or base "https://hf-mirror.com"))
                                  "/" repo "/resolve/" rev "/" path))
      ((modelscope) (string-append (trim-slashes (or base "https://www.modelscope.cn"))
                                   "/models/" repo "/resolve/" rev "/" path))
      ((url)
       (unless base (error "url source requires base_url" spec))
       (string-append (trim-slashes base) "/"
                      (if (string-null? repo) path
                          (string-append repo "/resolve/" rev "/" path))))
      (else (and base (string-append (trim-slashes base) "/" repo "/resolve/" rev "/" path))))))

(define (api-base source default)
  (let ((spec (cdr source)))
    (trim-slashes (or (ref spec 'base_url) default))))

(define (json-field object key)
  (let ((entry (and (list? object) (assoc key object))))
    (and entry (cdr entry))))

(define (http-json url)
  (let ((handle (curl-easy-init)))
    (dynamic-wind
      (lambda () (curl-options! handle url))
      (lambda ()
        (let ((body (curl-easy-perform handle #t))
              (code (curl-easy-getinfo handle 'response-code)))
          (unless (and (eqv? code 200) (bytevector? body))
            (error "repository listing failed" url code))
          (json-string->scm (utf8->string body))))
      (lambda () (curl-easy-cleanup handle)))))

(define (list-repo-files source repo revision)
  (let* ((kind (sym (car source)))
         (encoded
          (case kind
            ((huggingface hf-mirror)
             (string-append
              (api-base source
                        (if (eq? kind 'hf-mirror)
                            "https://hf-mirror.com"
                            "https://huggingface.co"))
              "/api/models/" repo "/tree/" revision "?recursive=true"))
            ((modelscope)
             (string-append
              (api-base source "https://www.modelscope.cn")
              "/api/v1/models/" repo "/repo/files?Revision=" revision
              "&Recursive=true"))
            (else (error "unsupported repository listing source" kind))))
         (payload (http-json encoded)))
    (case kind
      ((huggingface hf-mirror)
       (filter-map
        (lambda (item)
          (and (equal? (json-field item "type") "file")
               (let* ((lfs (json-field item "lfs"))
                      (sha (and lfs (json-field lfs "oid"))))
                 (list (json-field item "path")
                       (json-field item "size") sha))))
        (if (vector? payload) (vector->list payload) payload)))
      ((modelscope)
       (let* ((data (json-field payload "Data"))
              (files (json-field data "Files")))
         (filter-map
          (lambda (item)
            (and (equal? (json-field item "Type") "blob")
                 (list (json-field item "Path")
                       (json-field item "Size")
                       (json-field item "Sha256"))))
          (if (vector? files) (vector->list files) files)))))))

(define-record-type <directory-job>
  (make-directory-job entry final part state error files-done files-total
                      bytes-done bytes-total children cancelled lock thread)
  directory-job?
  (entry directory-job-entry) (final directory-job-final)
  (part directory-job-part) (state directory-job-state set-directory-job-state!)
  (error directory-job-error set-directory-job-error!)
  (files-done directory-job-files-done set-directory-job-files-done!)
  (files-total directory-job-files-total set-directory-job-files-total!)
  (bytes-done directory-job-bytes-done set-directory-job-bytes-done!)
  (bytes-total directory-job-bytes-total set-directory-job-bytes-total!)
  (children directory-job-children set-directory-job-children!)
  (cancelled directory-job-cancelled set-directory-job-cancelled!)
  (lock directory-job-lock) (thread directory-job-thread set-directory-job-thread!))

(define (directory-job-status job)
  (with-mutex (directory-job-lock job)
    (let ((children (directory-job-children job)))
      (set-directory-job-bytes-done!
       job (fold (lambda (child total)
                   (+ total (or (ref (job-status child) 'bytes-done) 0)))
                 0 children))
      `((state . ,(directory-job-state job))
        (bytes-done . ,(directory-job-bytes-done job))
        (bytes-total . ,(directory-job-bytes-total job))
        (files-done . ,(directory-job-files-done job))
        (files-total . ,(directory-job-files-total job))
        (error . ,(directory-job-error job))))))

(define (cancel-directory-job! job)
  (with-mutex (directory-job-lock job)
    (set-directory-job-cancelled! job #t)
    (set-directory-job-state! job "cancelled")
    (for-each cancel-job! (directory-job-children job)))
  #t)

(define (run-directory-job! job sources)
  (guard (ex
          (#t
           (set-directory-job-error! job (exception-text ex))
           (set-directory-job-state!
            job (if (directory-job-cancelled job) "cancelled" "failed"))))
    (set-directory-job-state! job "listing")
    (let* ((listed
            (let loop ((left sources))
              (if (null? left)
                  (error "all repository listings failed")
                  (guard (ex (#t
                              (format (current-error-port)
                                      "directory listing failed for ~s: ~s~%"
                                      (car (car left)) ex)
                              (loop (cdr left))))
                    (let* ((source (car left))
                           (original (cons (ref source 'name) (ref source 'spec)))
                           (repo (ref (ref source 'spec) 'repo))
                           (revision (or (ref (ref source 'spec) 'revision) "main")))
                      (cons original
                            (list-repo-files original repo revision)))))))
           (chosen (car listed))
           (files (cdr listed)))
    (set-directory-job-files-total! job (length files))
    (set-directory-job-bytes-total! job
      (fold (lambda (file total) (+ total (or (cadr file) 0))) 0 files))
    (set-directory-job-state! job "downloading")
    (for-each
     (lambda (file)
       (when (directory-job-cancelled job)
         (throw 'directory-cancelled file))
       (let* ((path (car file)) (size (cadr file)) (sha (caddr file))
              (entry `((path . ,path) (size . ,size)
                       (sha256 . ,(or sha ""))
                       (sources . (,chosen))))
              (child (start-download-job entry (directory-job-part job))))
         (with-mutex (directory-job-lock job)
           (set-directory-job-children!
            job (append (directory-job-children job) (list child))))
         (let loop ()
           (let* ((status (job-status child))
                  (state (ref status 'state)))
             (cond ((equal? state "done")
                    (set-directory-job-files-done!
                     job (+ 1 (directory-job-files-done job))))
                   ((member state '("failed" "cancelled"))
                    (error "directory file failed" path status))
                   (else (usleep 100000) (loop)))))))
     files)
    (when (file-exists? (directory-job-final job))
      (error "target directory already exists" (directory-job-final job)))
    (rename-file (directory-job-part job) (directory-job-final job))
    (set-directory-job-state! job "done"))))

(define (start-directory-job catalog-entry models-root)
  (let* ((folder (ref catalog-entry 'folder))
         (directory (ref catalog-entry 'directory))
         (final (string-append (trim-slashes models-root) "/" folder "/" directory))
         (part (string-append final ".khala-part"))
         (sources (select-sources catalog-entry))
         (job (make-directory-job catalog-entry final part "queued" #f 0 0 0 0
                                  '() #f (make-mutex) #f)))
    (unless (and folder directory (pair? sources))
      (error "invalid directory catalog entry"))
    (ensure-parent final)
    (unless (file-exists? part) (mkdir part #o755))
    (set-directory-job-thread!
     job (call-with-new-thread (lambda () (run-directory-job! job sources))))
    job))
(define (catalog-sources entry)
  (let ((sources (or (ref entry 'sources) '())))
    (filter-map
     (lambda (s)
       (let* ((kind (sym (car s)))
              (url (source-url s (ref entry 'path))))
         (and url
              (list (cons 'name kind) (cons 'url url)
                    (cons 'host (source-host url)) (cons 'spec (cdr s))
                    (cons 'kind kind)))))
     sources)))

(define (curl-options! h url)
  (curl-easy-setopt h 'url url)
  (curl-easy-setopt h 'followlocation #t)
  (curl-easy-setopt h 'connecttimeout 15))
(define (download-range-to-fd url start end fd)
  (let ((h (curl-easy-init)))
    (dynamic-wind
      (lambda ()
        (curl-options! h url)
        (curl-easy-setopt h 'range (format #f "~a-~a" start end)))
      (lambda () (curl-easy-perform-to-fd h fd start))
      (lambda () (curl-easy-cleanup h)))))
(define (header-value headers key)
  (let loop ((lines (string-split headers #\newline)) (value #f))
    (if (null? lines) value
        (let* ((line (string-trim-right (car lines)))
               (colon (string-index line #\:)))
          (loop (cdr lines)
                (if (and colon (string-ci=? (substring line 0 colon) key))
                    (string-trim-both (substring line (+ colon 1))) value))))))
(define (download-head-size url)
  (let ((h (curl-easy-init)))
    (dynamic-wind
      (lambda ()
        (curl-options! h url)
        (curl-easy-setopt h 'nobody #t))
      (lambda ()
        (let ((result (curl-easy-perform h #f #t)))
          (and result
               (let ((size (curl-easy-getinfo h 'content-length-download-t)))
                 (and (number? size) (> size 0) size)))))
      (lambda () (curl-easy-cleanup h)))))

(define (header-ref headers key)
  (let loop ((lines (string-split headers #\newline)) (found #f))
    (if (null? lines) found
        (let* ((line (string-trim-right (car lines)))
               (colon (string-index line #\:)))
          (loop (cdr lines)
                (if (and colon (string-ci=? key (substring line 0 colon)))
                    (string-trim-both (substring line (+ colon 1))) found))))))
(define (head-info source)
  (let ((h (curl-easy-init)))
    (dynamic-wind
      (lambda ()
        (curl-options! h (ref source 'url))
        (curl-easy-setopt h 'nobody #t))
      (lambda ()
        (let ((result (curl-easy-perform h #f #t)))
          (unless result
            (error "HEAD request failed" (curl-error-code) (curl-error-string)))
          (let ((size (curl-easy-getinfo h 'content-length-download-t))
                (headers (car result)))
            (cons (and (number? size) (> size 0) size)
                  (or (header-ref headers "X-Linked-Etag")
                      (header-ref headers "ETag"))))))
      (lambda () (curl-easy-cleanup h)))))

(define mirror-cache (make-hash-table))
(define mirror-cache-lock (make-mutex))
(define last-probe-scores '())
(define (ticks) (get-internal-real-time))
(define (ticks-per-second) internal-time-units-per-second)
(define (cached-source sources)
  (with-mutex mirror-cache-lock
    (find-map
     (lambda (s)
       (let ((cached (hash-ref mirror-cache (ref s 'host) #f)))
         (and cached (> (car cached) (ticks))
              (find (lambda (candidate)
                      (eq? (ref candidate 'name) (cdr cached))) sources))))
     sources)))
(define (source-host url)
  (let ((start (string-contains url "://")))
    (if start
        (let* ((begin (+ start 3)) (slash (string-index url #\/ begin)))
          (substring url begin (or slash (string-length url))))
        "")))
(define (probe-source source)
  (guard (ex (#t (trace-exception! 'probe ex) (cons 0 source)))
    (let* ((port (open-file "/dev/null" "wb"))
           (start (ticks))
           (h (curl-easy-init)))
      (dynamic-wind
        (lambda ()
          (curl-options! h (ref source 'url))
          (curl-easy-setopt h 'range
            (format #f "0-~a" (- (cfg 'mirror_probe_bytes) 1)))
          (curl-easy-setopt h 'timeout (cfg 'mirror_probe_timeout)))
        (lambda ()
          (let* ((n (curl-easy-perform-to-fd h (port->fdes port)))
                 (elapsed (max 0.000001
                               (/ (- (ticks) start) (ticks-per-second)))))
            (cons (if (number? n) (/ n elapsed) 0) source)))
        (lambda () (curl-easy-cleanup h) (close-port port))))))
(define (rank-sources sources)
  (let ((cached (cached-source sources)))
    (if cached
        (cons cached (filter (lambda (s) (not (eq? s cached))) sources))
        (let* ((threads
                (map (lambda (source)
                       (call-with-new-thread (lambda () (probe-source source))))
                     sources))
               (ranked (sort (map join-thread threads)
                             (lambda (a b) (> (car a) (car b)))))
               (ordered (map cdr (filter (lambda (x) (> (car x) 0)) ranked))))
          (set! last-probe-scores
                (map (lambda (result)
                       (cons (name (ref (cdr result) 'name)) (car result)))
                     ranked))
          (when (pair? ordered)
            (let ((winner (car ordered)))
              (with-mutex mirror-cache-lock
                (hash-set! mirror-cache (ref winner 'host)
                           (cons (+ (ticks) (* (cfg 'mirror_cache_minutes) 60
                                               (ticks-per-second)))
                                 (ref winner 'name))))))
          (append ordered (filter (lambda (s) (not (member s ordered))) sources))))))
(define (select-sources entry)
  (let* ((sources (catalog-sources entry)) (mirror (cfg 'mirror)))
    (if (or (not mirror) (equal? mirror "auto"))
        (let ((ranked (rank-sources sources)))
          ;; Keep catalog order usable when every probe fails or a probe
          ;; implementation returns no ranking.
          (if (list? ranked) ranked sources))
        (let ((chosen (find (lambda (s) (equal? (name (ref s 'name)) mirror)) sources)))
          (if chosen (list chosen) '())))))

(define (file-key entry)
  (format #f "~a|~a|~a" (ref entry 'path) (or (ref entry 'sha256) "")
          (or (ref entry 'size) "unknown")))
(define (read-sidecar job key size chunk)
  (if (not (file-exists? (job-sidecar job))) '()
      (guard (ex (#t '()))
        (let* ((obj (json-string->scm
                     (call-with-input-file (job-sidecar job) get-string-all)))
               (indices (ref obj "completed")))
          (if (and (equal? (ref obj "file_key") key)
                   (equal? (ref obj "size") size)
                   (equal? (ref obj "chunk_size") chunk))
              (if (vector? indices) (vector->list indices) indices)
              '())))))
(define (write-sidecar! job key)
  (let* ((tmp (string-append (job-sidecar job) ".tmp"))
         (obj (make-json-object
               (list (cons "file_key" key) (cons "size" (job-size job))
                     (cons "chunk_size" (job-chunk-size job))
                     (cons "completed" (list->vector (sort (job-complete job) <)))))))
    (call-with-output-file tmp (lambda (p) (display (json-encode obj) p)))
    (rename-file tmp (job-sidecar job))))
(define (chunk-count size chunk) (if (zero? size) 0 (ceiling (/ size chunk))))
(define (chunk-bounds size chunk i)
  (let ((start (* i chunk))) (cons start (min (- size 1) (+ start chunk -1)))))
(define (chunk-length bounds) (+ 1 (- (cdr bounds) (car bounds))))
(define (prepare-part! job key)
  (let* ((port (open (job-part job) (logior O_RDWR O_CREAT) #o644))
         (size (job-size job)) (chunk (job-chunk-size job))
         (existing (and (file-exists? (job-part job))
                        (= size (stat:size (stat (job-part job))))))
         (completed (if existing (read-sidecar job key size chunk) '())))
    (unless existing (truncate-file port size))
    (set-complete! job completed)
    (set-pending! job (filter (lambda (i) (not (member i completed)))
                              (iota (chunk-count size chunk))))
    (write-sidecar! job key)
    port))

(define (register-active! job handle length)
  (with-mutex (job-lock job)
    (set-active! job (cons (list handle length) (job-active job)))))
(define (unregister-active! job handle)
  (with-mutex (job-lock job)
    (set-active! job (filter (lambda (x) (not (eq? (car x) handle))) (job-active job)))))
(define (chunk-fetch! job handle source index bounds fd)
  (let* ((start (car bounds)) (end (cdr bounds)) (size (chunk-length bounds)))
    (curl-easy-reset handle)
    (curl-options! handle (ref source 'url))
    (curl-easy-setopt handle 'range (format #f "~a-~a" start end))
    (curl-easy-setopt handle 'low-speed-limit 65536)
    (curl-easy-setopt handle 'low-speed-time 30)
    (register-active! job handle size)
    (let ((count (curl-easy-perform-to-fd handle fd start)))
      (unregister-active! job handle)
      (unless (and (number? count) (= count size))
        (let* ((http (guard (ex (#t #f))
                       (curl-easy-getinfo handle 'response-code)))
               (message (format #f "chunk write got ~s bytes, expected ~s; HTTP ~s; curl ~a: ~a"
                                count size http (curl-error-code) (curl-error-string))))
          (format (current-error-port) "khala/download ~a~%" message)))
      (and (number? count) (= count size)))))
(define (mark-complete! job index key)
  (with-mutex (job-lock job)
    (unless (member index (job-complete job))
      (set-complete! job (cons index (job-complete job)))
      (write-sidecar! job key))))
(define (take-chunk! job)
  (with-mutex (job-lock job)
    (if (null? (job-pending job)) #f
        (let ((i (car (job-pending job))))
          (set-pending! job (cdr (job-pending job))) i))))
(define (sleep-retry! seconds)
  (usleep (* seconds 1000000)))
(define (fetch-with-retry! job handle index fd key)
  (let ((sources (job-sources job))
        (bounds (chunk-bounds (job-size job) (job-chunk-size job) index)))
    (let source-loop ((si 0))
      (if (or (job-cancelled? job) (>= si (length sources))) #f
          (let ((source (list-ref sources si)))
            (set-source! job (name (ref source 'name)))
            (let retry-loop ((attempt 0))
              (cond
               ((job-cancelled? job) #f)
               ((chunk-fetch! job handle source index bounds fd)
                (mark-complete! job index key) #t)
               ((< attempt 3)
                (sleep-retry! (list-ref '(1 4 16) attempt))
                (retry-loop (+ attempt 1)))
               (else (source-loop (+ si 1))))))))))
(define (worker-loop! job fd key)
  (let ((handle (curl-easy-init)))
    (dynamic-wind
      (lambda ()
        (with-mutex (job-lock job)
          (set-handles! job (cons handle (job-handles job)))))
      (lambda ()
        (guard (ex (#t (job-fail! job 'worker ex)))
          (let loop ()
            (unless (or (job-cancelled? job) (job-error job))
              (let ((i (take-chunk! job)))
                (when i
                  (unless (fetch-with-retry! job handle i fd key)
                    (unless (job-cancelled? job)
                      (unless (job-error job)
                        (set-error! job (format #f "all sources failed for chunk ~a" i)))))
                  (loop)))))))
      (lambda ()
        (curl-easy-cleanup handle)
        (with-mutex (job-lock job)
          (set-handles! job (filter (lambda (h) (not (eq? h handle)))
                                    (job-handles job))))))))
(define (cancel-job! job)
  (set-cancelled! job #t)
  (with-mutex (job-lock job)
    (for-each (lambda (entry) (curl-easy-cancel! (car entry)))
              (job-active job)))
  #t)


(define (exception-text ex)
  (call-with-output-string (lambda (p) (write ex p))))
(define (trace-exception! who ex)
  (format (current-error-port) "khala/download ~a: ~a~%" who (exception-text ex))
  (let ((trace (open-output-string)))
    (catch #t (lambda () (display-backtrace (make-stack #t) trace))
           (lambda _ #f))
    (format (current-error-port) "backtrace: ~s~%" (get-output-string trace))))
(define (job-fail! job who ex)
  (trace-exception! who ex)
  (set-error! job (exception-text ex))
  (unless (job-cancelled? job) (set-state! job "failed")))

(define (job-status job)
  (let* ((now (get-internal-real-time))
         (bytes (with-mutex (job-lock job)
                  (let* ((done (fold (lambda (i n)
                                       (+ n (min (job-chunk-size job)
                                                 (- (job-size job) (* i (job-chunk-size job))))))
                                     0 (job-complete job)))
                         (live (fold (lambda (entry n)
                                       (let* ((progress (curl-easy-progress (car entry)))
                                              (downloaded (car progress))
                                              (total (cdr progress))
                                              (limit (cadr entry)))
                                         (when (and (not (job-size job))
                                                    (number? total) (> total 0))
                                           (set-total! job total))
                                         (+ n (if (number? limit)
                                                  (min limit downloaded)
                                                  downloaded))))
                                     0 (job-active job)))
                         (value (+ done live))
                         (monotonic (max value (job-bytes-seen job)))
                         (samples (cons (cons now monotonic)
                                        (filter (lambda (sample)
                                                  (< (- now (car sample))
                                                     (* 2 internal-time-units-per-second)))
                                                (job-samples job)))))
                    (set-samples! job samples)
                    (set-bytes-seen! job monotonic)
                    (if (pair? (cdr samples))
                        (let* ((old (last samples)) (new (car samples))
                               (dt (/ (- (car new) (car old))
                                      internal-time-units-per-second)))
                          (set-speed! job (if (> dt 0) (/ (- (cdr new) (cdr old)) dt) 0)))
                        (set-speed! job 0))
                    (if (job-size job) (min (job-size job) monotonic) monotonic)))))
    `((state . ,(job-state job)) (bytes-done . ,bytes)
      (bytes-total . ,(job-total job)) (speed . ,(job-speed job))
      (source . ,(job-source job)) (error . ,(job-error job))
      (verified . ,(job-verified? job)))))

(define (sha256-file path)
  (let* ((pipe (open-pipe* OPEN_READ "sha256sum" path))
         (line (read-line pipe)))
    (close-pipe pipe)
    (and (string? line) (substring line 0 64))))
(define (sha256-etag etag)
  (and etag
       (let* ((clean (string-trim-both etag #\"))
              (lower (string-downcase clean)))
         (and (= (string-length lower) 64)
              (string-every (lambda (c) (or (char-numeric? c)
                                            (char<=? #\a (char-downcase c) #\f))) lower)
              lower))))
(define (verify-and-rename! job etag)
  (set-state! job "verifying")
  (let* ((expected (or (ref (job-entry job) 'sha256) (sha256-etag etag)))
         (actual (sha256-file (job-part job))))
    (when (and expected (not (string-ci=? expected actual)))
      (error "SHA-256 mismatch" expected actual))
    (set-verified! job (and expected #t))
    (rename-file (job-part job) (job-final job))
    (when (file-exists? (job-sidecar job)) (delete-file (job-sidecar job)))
    (set-state! job "done")))
(define (start-sequential! job source etag)
  (let* ((port (open (job-part job) (logior O_WRONLY O_CREAT O_TRUNC) #o644))
         (handle (curl-easy-init)))
    (dynamic-wind
      (lambda ()
        (set-source! job (name (ref source 'name)))
        (curl-options! handle (ref source 'url))
        (curl-easy-setopt handle 'low-speed-limit 65536)
        (curl-easy-setopt handle 'low-speed-time 30)
        (curl-easy-setopt handle 'connecttimeout 15)
        (register-active! job handle #f))
      (lambda ()
        (set-state! job "downloading")
        (let ((count (curl-easy-perform-to-fd handle (port->fdes port))))
          (unless (number? count)
            (error "sequential transfer failed" (curl-error-string)))
          (set-size! job count)
          (set-total! job count)
          (set-bytes-seen! job count)
          (verify-and-rename! job etag)))
      (lambda ()
        (unregister-active! job handle)
        (curl-easy-cleanup handle)
        (close-port port)))))
(define (head-first sources)
  (let loop ((left sources))
    (if (null? left) #f
        (let* ((source (car left))
               (info (guard (ex (#t (trace-exception! 'head ex) #f)) (head-info source))))
          (if info (cons source info) (loop (cdr left)))))))
(define (run-job! job)
  (guard (ex (#t (job-fail! job 'run-job ex)))
    (set-state! job "probing")
    (let ((sources (select-sources (job-entry job))))
      (unless (pair? sources) (error "no usable source in catalog entry"))
      (set-sources! job sources)
      (let ((selected (head-first sources)))
        (unless selected (error "all HEAD requests failed"))
        (let* ((source (car selected))
               (info (cdr selected))
               (size (or (ref (job-entry job) 'size) (car info)))
               (etag (cdr info)))
          (set-source! job (name (ref source 'name)))
          (set-size! job size)
          (set-total! job size)
          (if (not size)
              (start-sequential! job source etag)
              (let* ((key (file-key (job-entry job)))
                     (port (prepare-part! job key))
                     (fd (port->fdes port)))
                (set-state! job "downloading")
                (let* ((count (max 1 (cfg 'download_threads)))
                       (workers
                        (map (lambda (_)
                               (call-with-new-thread
                                (lambda ()
                                  (guard (ex (#t (job-fail! job 'worker-thread ex)))
                                    (worker-loop! job fd key)))))
                             (iota count))))
                  (for-each join-thread workers))
                (close-port port)
                (cond
                 ((job-cancelled? job) (set-state! job "cancelled"))
                 ((job-error job) (error (job-error job)))
                 (else (verify-and-rename! job etag))))))))))
(define (start-download-job catalog-entry dest-dir)
  (let* ((path (ref catalog-entry 'path))
         (chunk (* (cfg 'download_chunk_mib) 1024 1024))
         (sources (catalog-sources catalog-entry)))
    (unless (safe-relative? path) (error "unsafe download path" path))
    (unless (pair? sources) (error "catalog entry has no configured sources" path))
    (let* ((final (string-append (trim-slashes dest-dir) "/" path))
           (part (string-append final ".khala-part"))
           (sidecar (string-append part ".json"))
           (job (make-job catalog-entry dest-dir final part sidecar
                          (ref catalog-entry 'size) chunk sources "queued" #f
                          #f #f '() '() '() '() (make-mutex) #f '()
                          (ref catalog-entry 'size) 0
                          (name (ref (car sources) 'name)) (ticks) 0)))
      (ensure-parent final)
      (set-thread! job
        (call-with-new-thread
         (lambda ()
           (guard (ex (#t (job-fail! job 'job-thread ex)))
             (run-job! job)))))
      job)))
