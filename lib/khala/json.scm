(define-module (khala json)
  #:use-module (json builder)
  #:use-module (srfi srfi-9)
  #:use-module (srfi srfi-1)
  #:use-module (srfi srfi-13)
  #:export (make-json-object json-object? json-object-fields json-encode json-normalize))

(define-record-type <json-object>
  (make-json-object fields)
  json-object?
  (fields json-object-fields))

(define (json-normalize value)
  (cond
   ((json-object? value)
    (make-json-object
     (map (lambda (entry) (cons (car entry) (json-normalize (cdr entry))))
          (json-object-fields value))))
   ((and (list? value) (every pair? value) (every string? (map car value)))
    (make-json-object
     (map (lambda (entry) (cons (car entry) (json-normalize (cdr entry)))) value)))
   ((list? value) (map json-normalize value))
   ((vector? value) (list->vector (map json-normalize (vector->list value))))
   (else value)))

(define (json-encode value)
  (define (emit value port)
    (cond
     ((json-object? value)
      (display "{" port)
      (let loop ((fields (json-object-fields value)) (first? #t))
        (unless (null? fields)
          (unless first? (display "," port))
          (display (scm->json-string (caar fields)) port)
          (display ":" port)
          (emit (cdar fields) port)
          (loop (cdr fields) #f)))
      (display "}" port))
     ((or (list? value) (vector? value))
      (let ((items (if (vector? value) (vector->list value) value)))
        (display "[" port)
        (let loop ((items items) (first? #t))
          (unless (null? items)
            (unless first? (display "," port))
            (emit (car items) port)
            (loop (cdr items) #f)))
        (display "]" port)))
     ((string? value) (display (scm->json-string value) port))
     ((eq? value #t) (display "true" port))
     ((eq? value #f) (display "false" port))
     ((eq? value 'null) (display "null" port))
     ((number? value) (display (number->string value) port))
     (else (display "null" port))))
  (call-with-output-string (lambda (port) (emit value port))))
