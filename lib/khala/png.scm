(define-module (khala png)
  #:use-module (rnrs bytevectors)
  #:use-module (rnrs arithmetic bitwise)
  #:use-module (rnrs io ports)
  #:use-module (srfi srfi-1)
  #:export (rgb->png png-add-text png-with-metadata png-read-text
            png-mask-composite))

(define signature #vu8(137 80 78 71 13 10 26 10))
(define crc-table
  (let ((table (make-vector 256)))
    (do ((n 0 (+ n 1))) ((= n 256) table)
      (let loop ((c n) (k 0))
        (if (= k 8)
            (vector-set! table n c)
            (loop (if (odd? c)
                      (logxor #xedb88320 (ash c -1))
                      (ash c -1))
                  (+ k 1)))))))

(define (crc32 bytes)
  (let loop ((i 0) (crc #xffffffff))
    (if (= i (bytevector-length bytes))
        (logxor crc #xffffffff)
        (loop (+ i 1)
              (logxor (vector-ref crc-table
                                  (logand #xff (logxor crc
                                                       (bytevector-u8-ref bytes i))))
                      (ash crc -8))))))

(define (u32be value)
  (let ((bv (make-bytevector 4)))
    (bytevector-u8-set! bv 0 (logand #xff (ash value -24)))
    (bytevector-u8-set! bv 1 (logand #xff (ash value -16)))
    (bytevector-u8-set! bv 2 (logand #xff (ash value -8)))
    (bytevector-u8-set! bv 3 (logand #xff value))
    bv))

(define (get-u32be bv offset)
  (+ (ash (bytevector-u8-ref bv offset) 24)
     (ash (bytevector-u8-ref bv (+ offset 1)) 16)
     (ash (bytevector-u8-ref bv (+ offset 2)) 8)
     (bytevector-u8-ref bv (+ offset 3))))

(define (bytes . arrays)
  (let* ((size (apply + (map bytevector-length arrays)))
         (result (make-bytevector size)))
    (let loop ((items arrays) (offset 0))
      (unless (null? items)
        (bytevector-copy! (car items) 0 result offset (bytevector-length (car items)))
        (loop (cdr items) (+ offset (bytevector-length (car items))))))
    result))

(define (slice bv start end)
  (let ((result (make-bytevector (- end start))))
    (bytevector-copy! bv start result 0 (- end start))
    result))

(define (ascii text)
  (string->utf8 text))

(define (png-chunk type data)
  (let* ((type-bytes (ascii type))
         (crc-input (bytes type-bytes data)))
    (bytes (u32be (bytevector-length data)) type-bytes data
           (u32be (crc32 crc-input)))))

(define (adler32 data)
  (let loop ((i 0) (a 1) (b 0))
    (if (= i (bytevector-length data))
        (+ (ash b 16) a)
        (let ((next-a (modulo (+ a (bytevector-u8-ref data i)) 65521)))
          (loop (+ i 1) next-a (modulo (+ b next-a) 65521))))))

(define (zlib-stored data)
  (call-with-values open-bytevector-output-port
    (lambda (out get-output-bytevector)
    (put-bytevector out #vu8(120 1))
    (let loop ((offset 0))
      (let* ((remaining (- (bytevector-length data) offset))
             (length (min remaining 65535))
             (final? (= remaining length)))
        (put-u8 out (if final? 1 0))
        (put-u8 out (logand #xff length))
        (put-u8 out (logand #xff (ash length -8)))
        (let ((nlen (logxor length #xffff)))
          (put-u8 out (logand #xff nlen))
          (put-u8 out (logand #xff (ash nlen -8))))
        (put-bytevector out data offset length)
        (unless final? (loop (+ offset length)))))
      (let ((compressed (get-output-bytevector)))
        (bytes compressed (u32be (adler32 data)))))))

(define (rgb->png width height rgb)
  (let* ((stride (+ (* width 3) 1))
         (raw (make-bytevector (* stride height)))
         (ihdr (bytes (u32be width) (u32be height)
                      #vu8(8 2 0 0 0))))
    (do ((y 0 (+ y 1))) ((= y height))
      (bytevector-u8-set! raw (* y stride) 0)
      (bytevector-copy! rgb (* y width 3) raw (+ (* y stride) 1) (* width 3)))
    (bytes signature (png-chunk "IHDR" ihdr)
           (png-chunk "IDAT" (zlib-stored raw))
           (png-chunk "IEND" #vu8()))))

(define (png-add-text png key value)
  (let* ((position 8)
         (chunks '())
         (text-chunk (png-chunk "tEXt"
                                (bytes (ascii key) #vu8(0) (ascii value)))))
    (let loop ((offset position))
      (if (>= offset (bytevector-length png))
          (bytes signature (apply bytes (reverse chunks)))
          (let* ((length (get-u32be png offset))
                 (type (utf8->string (slice png (+ offset 4) (+ offset 8))))
                 (end (+ offset 12 length))
                 (chunk (slice png offset end)))
            (set! chunks (cons chunk chunks))
            (if (string=? type "IHDR")
                (begin
                  (set! chunks (cons text-chunk chunks))
                  (loop end))
                (loop end)))))))

(define (png-with-metadata png prompt-json workflow-json)
  (let ((with-workflow (if workflow-json
                           (png-add-text png "workflow" workflow-json)
                           png)))
    (png-add-text with-workflow "prompt" prompt-json)))

(define (png-read-text png key)
  (let loop ((offset 8))
    (if (>= offset (bytevector-length png))
        #f
        (let* ((length (get-u32be png offset))
               (type (utf8->string (slice png (+ offset 4) (+ offset 8))))
               (end (+ offset 12 length)))
          (if (string=? type "tEXt")
              (let* ((data (slice png (+ offset 8) (+ offset 8 length)))
                     (zero (let find ((i 0))
                             (cond ((= i length) #f)
                                   ((= (bytevector-u8-ref data i) 0) i)
                                   (else (find (+ i 1)))))))
                (if (and zero
                         (string=? key (utf8->string (slice data 0 zero))))
                    (utf8->string (slice data (+ zero 1) length))
                    (loop end)))
              (loop end))))))

(define (paeth a b c)
  (let* ((p (- (+ a b) c)) (pa (abs (- p a)))
         (pb (abs (- p b))) (pc (abs (- p c))))
    (cond ((and (<= pa pb) (<= pa pc)) a)
          ((<= pb pc) b) (else c))))

(define (inflate-stored zlib)
  (let ((out (open-bytevector-output-port)) (length (bytevector-length zlib)))
    (let loop ((offset 2))
      (when (>= offset (- length 4)) (error "truncated PNG zlib stream"))
      (let* ((header (bytevector-u8-ref zlib offset))
             (final? (= 1 (logand header 1)))
             (type (logand 3 (ash header -1)))
             (n (+ offset 1))
             (count (+ (bytevector-u8-ref zlib n)
                       (* 256 (bytevector-u8-ref zlib (+ n 1)))))
             (inverse (+ (bytevector-u8-ref zlib (+ n 2))
                         (* 256 (bytevector-u8-ref zlib (+ n 3))))))
        (unless (and (= type 0) (= (logxor count #xffff) inverse)
                     (<= (+ n 4 count) (- length 4)))
          (error "unsupported PNG deflate block" type count inverse))
        (put-bytevector out zlib (+ n 4) count)
        (if final? (get-output-bytevector out) (loop (+ n 4 count)))))))

(define (png-data png)
  (let loop ((offset 8) (ihdr #f) (idats '()) (other '()))
    (let* ((count (get-u32be png offset))
           (type (utf8->string (slice png (+ offset 4) (+ offset 8))))
           (end (+ offset 12 count))
           (data (slice png (+ offset 8) (+ offset 8 count))))
      (cond ((string=? type "IHDR") (loop end data idats other))
            ((string=? type "IDAT") (loop end ihdr (cons data idats) other))
            ((string=? type "IEND")
             (values ihdr (apply bytes (reverse idats)) (reverse other)))
            (else (loop end ihdr idats
                        (cons (slice png offset end) other)))))))

(define (decode-own-png png)
  (call-with-values (lambda () (png-data png))
    (lambda (ihdr compressed other)
      (let* ((width (get-u32be ihdr 0))
             (height (get-u32be ihdr 4))
             (depth (bytevector-u8-ref ihdr 8))
             (color (bytevector-u8-ref ihdr 9))
             (channels (cond ((= color 2) 3) ((= color 6) 4) (else #f))))
        (unless (and (= depth 8) channels)
          (error "unsupported PNG color type or bit depth" color depth))
        (let* ((stride (* width channels))
               (inflated (inflate-stored compressed))
               (pixels (make-bytevector (* stride height))))
          (unless (= (bytevector-length inflated) (* height (+ stride 1)))
            (error "invalid stored PNG scanline length"))
          (do ((y 0 (+ y 1))) ((= y height))
            (let ((filter (bytevector-u8-ref inflated (* y (+ stride 1)))))
              (do ((x 0 (+ x 1))) ((= x stride))
                (let* ((raw (bytevector-u8-ref inflated (+ (* y (+ stride 1)) 1 x)))
                       (left (if (>= x channels)
                                 (bytevector-u8-ref pixels (+ (* y stride) x channels)) 0))
                       (above (if (> y 0)
                                  (bytevector-u8-ref pixels (+ (* (- y 1) stride) x)) 0))
                       (upper-left (if (and (> y 0) (>= x channels))
                                       (bytevector-u8-ref pixels
                                         (+ (* (- y 1) stride) x (- channels))) 0))
                       (predictor
                        (case filter
                          ((0) 0) ((1) left) ((2) above)
                          ((3) (quotient (+ left above) 2))
                          ((4) (paeth left above upper-left))
                          (else (error "unsupported PNG row filter" filter)))))
                  (bytevector-u8-set! pixels (+ (* y stride) x)
                                      (modulo (+ raw predictor) 256)))))
          (values width height channels pixels other ihdr)))))))

(define (png-mask-composite original mask)
  (call-with-values (lambda () (decode-own-png original))
    (lambda (width height channels pixels other ihdr)
      (call-with-values (lambda () (decode-own-png mask))
        (lambda (mw mh mchannels mpixels _mothers _mihdr)
          (unless (and (= width mw) (= height mh))
            (error "mask dimensions differ from original"))
          (let* ((rgba (make-bytevector (* width height 4)))
                 (stride (* width channels))
                 (mstride (* width mchannels))
                 (raw (make-bytevector (* height (+ (* width 4) 1))))
                 (new-ihdr (bytes (slice ihdr 0 9) #vu8(6) (slice ihdr 10 13))))
            (do ((y 0 (+ y 1))) ((= y height))
              (let ((raw-start (* y (+ (* width 4) 1))))
                (bytevector-u8-set! raw raw-start 0)
                (do ((x 0 (+ x 1))) ((= x width))
                  (let* ((src (+ (* y stride) (* x channels)))
                         (mask-src (+ (* y mstride) (* x mchannels)))
                         (dst (+ (* y (* width 4)) (* x 4)))
                         (row-dst (+ raw-start 1 (* x 4))))
                    (bytevector-u8-set! rgba dst (bytevector-u8-ref pixels src))
                    (bytevector-u8-set! rgba (+ dst 1) (bytevector-u8-ref pixels (+ src 1)))
                    (bytevector-u8-set! rgba (+ dst 2) (bytevector-u8-ref pixels (+ src 2)))
                    (bytevector-u8-set! rgba (+ dst 3) (bytevector-u8-ref mpixels mask-src))
                    (bytevector-u8-set! raw row-dst (bytevector-u8-ref rgba dst))
                    (bytevector-u8-set! raw (+ row-dst 1) (bytevector-u8-ref rgba (+ dst 1)))
                    (bytevector-u8-set! raw (+ row-dst 2) (bytevector-u8-ref rgba (+ dst 2)))
                    (bytevector-u8-set! raw (+ row-dst 3) (bytevector-u8-ref rgba (+ dst 3)))))))
            (let* ((chunks (append (list (png-chunk "IHDR" new-ihdr))
                                   other
                                   (list (png-chunk "IDAT" (zlib-stored raw))
                                         (png-chunk "IEND" #vu8())))))
              (apply bytes (cons signature chunks)))))))))
