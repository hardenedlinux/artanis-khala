(define-module (khala png)
  #:use-module (rnrs bytevectors)
  #:use-module (rnrs arithmetic bitwise)
  #:use-module (rnrs io ports)
  #:use-module (srfi srfi-1)
  #:export (rgb->png png-add-text png-with-metadata png-read-text))

(define signature #vu8(137 80 78 71 13 10 26 10))
(define crc-table
  (let ((table (make-vector 256)))
    (do ((n 0 (+ n 1))) ((= n 256) table)
      (let loop ((c n) (k 0))
        (if (= k 8)
            (vector-set! table n c)
            (loop (if (odd? c)
                      (logxor #xedb88320 (ash c -1))
                      (ash c -1))
                  (+ k 1)))))))

(define (crc32 bytes)
  (let loop ((i 0) (crc #xffffffff))
    (if (= i (bytevector-length bytes))
        (logxor crc #xffffffff)
        (loop (+ i 1)
              (logxor (vector-ref crc-table
                                  (logand #xff (logxor crc
                                                       (bytevector-u8-ref bytes i))))
                      (ash crc -8))))))

(define (u32be value)
  (let ((bv (make-bytevector 4)))
    (bytevector-u8-set! bv 0 (logand #xff (ash value -24)))
    (bytevector-u8-set! bv 1 (logand #xff (ash value -16)))
    (bytevector-u8-set! bv 2 (logand #xff (ash value -8)))
    (bytevector-u8-set! bv 3 (logand #xff value))
    bv))

(define (get-u32be bv offset)
  (+ (ash (bytevector-u8-ref bv offset) 24)
     (ash (bytevector-u8-ref bv (+ offset 1)) 16)
     (ash (bytevector-u8-ref bv (+ offset 2)) 8)
     (bytevector-u8-ref bv (+ offset 3))))

(define (bytes . arrays)
  (let* ((size (apply + (map bytevector-length arrays)))
         (result (make-bytevector size)))
    (let loop ((items arrays) (offset 0))
      (unless (null? items)
        (bytevector-copy! (car items) 0 result offset (bytevector-length (car items)))
        (loop (cdr items) (+ offset (bytevector-length (car items))))))
    result))

(define (slice bv start end)
  (let ((result (make-bytevector (- end start))))
    (bytevector-copy! bv start result 0 (- end start))
    result))

(define (ascii text)
  (string->utf8 text))

(define (png-chunk type data)
  (let* ((type-bytes (ascii type))
         (crc-input (bytes type-bytes data)))
    (bytes (u32be (bytevector-length data)) type-bytes data
           (u32be (crc32 crc-input)))))

(define (adler32 data)
  (let loop ((i 0) (a 1) (b 0))
    (if (= i (bytevector-length data))
        (+ (ash b 16) a)
        (let ((next-a (modulo (+ a (bytevector-u8-ref data i)) 65521)))
          (loop (+ i 1) next-a (modulo (+ b next-a) 65521))))))

(define (zlib-stored data)
  (call-with-values open-bytevector-output-port
    (lambda (out get-output-bytevector)
    (put-bytevector out #vu8(120 1))
    (let loop ((offset 0))
      (let* ((remaining (- (bytevector-length data) offset))
             (length (min remaining 65535))
             (final? (= remaining length)))
        (put-u8 out (if final? 1 0))
        (put-u8 out (logand #xff length))
        (put-u8 out (logand #xff (ash length -8)))
        (let ((nlen (logxor length #xffff)))
          (put-u8 out (logand #xff nlen))
          (put-u8 out (logand #xff (ash nlen -8))))
        (put-bytevector out data offset length)
        (unless final? (loop (+ offset length)))))
      (let ((compressed (get-output-bytevector)))
        (bytes compressed (u32be (adler32 data)))))))

(define (rgb->png width height rgb)
  (let* ((stride (+ (* width 3) 1))
         (raw (make-bytevector (* stride height)))
         (ihdr (bytes (u32be width) (u32be height)
                      #vu8(8 2 0 0 0))))
    (do ((y 0 (+ y 1))) ((= y height))
      (bytevector-u8-set! raw (* y stride) 0)
      (bytevector-copy! rgb (* y width 3) raw (+ (* y stride) 1) (* width 3)))
    (bytes signature (png-chunk "IHDR" ihdr)
           (png-chunk "IDAT" (zlib-stored raw))
           (png-chunk "IEND" #vu8()))))

(define (png-add-text png key value)
  (let* ((position 8)
         (chunks '())
         (text-chunk (png-chunk "tEXt"
                                (bytes (ascii key) #vu8(0) (ascii value)))))
    (let loop ((offset position))
      (if (>= offset (bytevector-length png))
          (bytes signature (apply bytes (reverse chunks)))
          (let* ((length (get-u32be png offset))
                 (type (utf8->string (slice png (+ offset 4) (+ offset 8))))
                 (end (+ offset 12 length))
                 (chunk (slice png offset end)))
            (set! chunks (cons chunk chunks))
            (if (string=? type "IHDR")
                (begin
                  (set! chunks (cons text-chunk chunks))
                  (loop end))
                (loop end)))))))

(define (png-with-metadata png prompt-json workflow-json)
  (let ((with-workflow (if workflow-json
                           (png-add-text png "workflow" workflow-json)
                           png)))
    (png-add-text with-workflow "prompt" prompt-json)))

(define (png-read-text png key)
  (let loop ((offset 8))
    (if (>= offset (bytevector-length png))
        #f
        (let* ((length (get-u32be png offset))
               (type (utf8->string (slice png (+ offset 4) (+ offset 8))))
               (end (+ offset 12 length)))
          (if (string=? type "tEXt")
              (let* ((data (slice png (+ offset 8) (+ offset 8 length)))
                     (zero (let find ((i 0))
                             (cond ((= i length) #f)
                                   ((= (bytevector-u8-ref data i) 0) i)
                                   (else (find (+ i 1)))))))
                (if (and zero
                         (string=? key (utf8->string (slice data 0 zero))))
                    (utf8->string (slice data (+ zero 1) length))
                    (loop end)))
              (loop end))))))
