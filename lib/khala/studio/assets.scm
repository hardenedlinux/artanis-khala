(define-module (khala studio assets)
  #:use-module (ice-9 format)
  #:use-module (ice-9 popen)
  #:use-module (ice-9 rdelim)
  #:use-module (rnrs bytevectors)
  #:use-module (rnrs io ports)
  #:use-module (srfi srfi-1)
  #:use-module (srfi srfi-13)
  #:use-module (khala config)
  #:export (studio-asset-max-bytes
            studio-asset-validate-upload
            studio-asset-storage-key
            studio-asset-store-file!
            studio-asset-resolve-path
            studio-asset-delete-file!))

(define (fail code message)
  (throw 'studio-asset-error code message))

(define (studio-asset-max-bytes config)
  (let ((value (config-ref config 'studio_asset_max_bytes)))
    (if (and (number? value) (> value 0)) value 4194304)))

(define (asset-root config)
  (let ((value (config-ref config 'studio_assets_dir)))
    (if (and (string? value) (not (string-null? value)))
        value
        "var/studio-assets")))

(define (ensure-directory path)
  (unless (or (string-null? path) (file-exists? path))
    (let ((parent (dirname path)))
      (unless (or (equal? parent path) (string-null? parent))
        (ensure-directory parent))
      (catch 'system-error
        (lambda () (mkdir path #o755))
        (lambda (key . args)
          (unless (file-exists? path)
            (apply throw key args)))))))

(define (safe-component? value)
  (and (string? value)
       (not (string-null? value))
       (not (string-contains value "/"))
       (not (string-contains value "\\"))
       (not (string-contains value ".."))
       (not (string-index value #\nul))))

(define (lower-extension filename)
  (let* ((name (string-downcase (or filename "")))
         (dot (string-rindex name #\.)))
    (if (and dot (> dot 0) (< dot (- (string-length name) 1)))
        (substring name dot)
        "")))

(define (safe-extension extension)
  (and (string? extension)
       (or (string-null? extension)
           (and (> (string-length extension) 1)
                (< (string-length extension) 14)
                (every (lambda (char)
                         (or (char-alphabetic? char) (char-numeric? char)))
                       (string->list (substring extension 1)))))
       extension))

(define (normalize-mime value)
  (let* ((text (and (string? value) (string-downcase (string-trim-both value))))
         (semicolon (and text (string-index text #\;))))
    (if semicolon
        (string-trim-both (substring text 0 semicolon))
        (or text ""))))

(define (safe-original-filename value)
  (let ((name (and (string? value) (basename value))))
    (unless (and name (safe-component? name) (<= (string-length name) 512))
      (fail 'invalid-filename "Upload filename is invalid"))
    name))

(define (expected-media extension)
  (cond
   ((member extension '(".png")) (list 'image "image/png" 'magic-png))
   ((member extension '(".jpg" ".jpeg")) (list 'image "image/jpeg" 'magic-jpeg))
   ((member extension '(".gif")) (list 'image "image/gif" 'magic-gif))
   ((member extension '(".webp")) (list 'image "image/webp" 'magic-webp))
   ((member extension '(".bmp")) (list 'image "image/bmp" 'magic-bmp))
   ((member extension '(".mp3")) (list 'audio "audio/mpeg" 'magic-mp3))
   ((member extension '(".wav")) (list 'audio "audio/wav" 'magic-wav))
   ((member extension '(".ogg" ".oga")) (list 'audio "audio/ogg" 'magic-ogg))
   ((member extension '(".flac")) (list 'audio "audio/flac" 'magic-flac))
   ((member extension '(".m4a")) (list 'audio "audio/mp4" 'magic-ftyp))
   ((member extension '(".mp4" ".m4v")) (list 'video "video/mp4" 'magic-ftyp))
   ((member extension '(".mov")) (list 'video "video/quicktime" 'magic-ftyp))
   ((member extension '(".webm")) (list 'media '("audio/webm" "video/webm") 'magic-ebml))
   ((member extension '(".ogv")) (list 'video "video/ogg" 'magic-ogg))
   ((member extension '(".pdf")) (list 'document "application/pdf" 'magic-pdf))
   ((member extension '(".md" ".markdown")) (list 'document "text/markdown" 'text))
   ((member extension '(".txt")) (list 'document "text/plain" 'text))
   ((member extension '(".csv")) (list 'document "text/csv" 'text))
   ((member extension '(".json")) (list 'document "application/json" 'text))
   ((member extension '(".docx"))
    (list 'document
          "application/vnd.openxmlformats-officedocument.wordprocessingml.document"
          'magic-zip))
   ((member extension '(".odt"))
    (list 'document "application/vnd.oasis.opendocument.text" 'magic-zip))
   ((member extension '(".epub")) (list 'document "application/epub+zip" 'magic-zip))
   ((member extension '(".zip")) (list 'other "application/zip" 'magic-zip))
   ((member extension '(".7z")) (list 'other "application/x-7z-compressed" 'magic-7z))
   ((member extension '(".rar")) (list 'other "application/vnd.rar" 'magic-rar))
   (else #f)))

(define (dangerous-extension? extension)
  (member extension
          '(".html" ".htm" ".xhtml" ".svg" ".svgz" ".js" ".mjs" ".cjs"
            ".php" ".py" ".scm" ".sh" ".bash" ".zsh" ".exe" ".dll" ".so"
            ".bat" ".cmd" ".ps1" ".jar" ".app" ".dmg" ".msi" ".wasm")))

(define (dangerous-mime? mime)
  (or (member mime '("text/html" "application/xhtml+xml" "image/svg+xml"
                     "text/javascript" "application/javascript"
                     "application/x-javascript"))
      (string-prefix? "text/x-" mime)))

(define (bytevector-starts? bytes pattern)
  (and (>= (bytevector-length bytes) (bytevector-length pattern))
       (let loop ((index 0))
         (or (= index (bytevector-length pattern))
             (and (= (bytevector-u8-ref bytes index)
                     (bytevector-u8-ref pattern index))
                  (loop (+ index 1)))))))

(define (bytevector-at? bytes offset pattern)
  (and (>= (bytevector-length bytes) (+ offset (bytevector-length pattern)))
       (let loop ((index 0))
         (or (= index (bytevector-length pattern))
             (and (= (bytevector-u8-ref bytes (+ offset index))
                     (bytevector-u8-ref pattern index))
                  (loop (+ index 1)))))))

(define (bytevector-has-nul? bytes)
  (let loop ((index 0))
    (and (< index (bytevector-length bytes))
         (or (= (bytevector-u8-ref bytes index) 0)
             (loop (+ index 1))))))

(define (magic-matches? magic bytes)
  (case magic
    ((magic-png) (bytevector-starts? bytes #vu8(#x89 #x50 #x4e #x47 #x0d #x0a #x1a #x0a)))
    ((magic-jpeg) (bytevector-starts? bytes #vu8(#xff #xd8 #xff)))
    ((magic-gif) (or (bytevector-starts? bytes (string->utf8 "GIF87a"))
                     (bytevector-starts? bytes (string->utf8 "GIF89a"))))
    ((magic-webp) (and (bytevector-starts? bytes (string->utf8 "RIFF"))
                       (bytevector-at? bytes 8 (string->utf8 "WEBP"))))
    ((magic-bmp) (bytevector-starts? bytes #vu8(#x42 #x4d)))
    ((magic-mp3) (or (bytevector-starts? bytes (string->utf8 "ID3"))
                     (and (>= (bytevector-length bytes) 2)
                          (= (bytevector-u8-ref bytes 0) #xff)
                          (= (logand (bytevector-u8-ref bytes 1) #xe0) #xe0))))
    ((magic-wav) (and (bytevector-starts? bytes (string->utf8 "RIFF"))
                      (bytevector-at? bytes 8 (string->utf8 "WAVE"))))
    ((magic-ogg) (bytevector-starts? bytes (string->utf8 "OggS")))
    ((magic-flac) (bytevector-starts? bytes (string->utf8 "fLaC")))
    ((magic-ftyp) (or (bytevector-at? bytes 4 (string->utf8 "ftyp"))
                      (bytevector-at? bytes 4 (string->utf8 "moov"))))
    ((magic-ebml) (bytevector-starts? bytes #vu8(#x1a #x45 #xdf #xa3)))
    ((magic-pdf) (bytevector-starts? bytes (string->utf8 "%PDF-")))
    ((magic-zip) (bytevector-starts? bytes #vu8(#x50 #x4b #x03 #x04)))
    ((magic-7z) (bytevector-starts? bytes #vu8(#x37 #x7a #xbc #xaf #x27 #x1c)))
    ((magic-rar) (or (bytevector-starts? bytes #vu8(#x52 #x61 #x72 #x21 #x1a #x07 #x00))
                     (bytevector-starts? bytes #vu8(#x52 #x61 #x72 #x21 #x1a #x07 #x01 #x00))))
    ((text)
     (and (not (bytevector-has-nul? bytes))
          (catch #t (lambda () (utf8->string bytes) #t) (lambda _ #f))))
    (else #f)))

(define (validate-mime extension mime)
  (let ((expected (expected-media extension)))
    (cond
     ((not expected)
      (when (or (dangerous-extension? extension) (dangerous-mime? mime))
        (fail 'unsupported-media-type "This file type is not allowed"))
      (unless (or (string-null? mime) (equal? mime "application/octet-stream")
                  (string-prefix? "application/" mime))
        (fail 'unsupported-media-type "MIME type is not allowed for this file"))
      mime)
     (else
      (let* ((kind (car expected))
             (mimes (if (eq? kind 'media)
                        (cadr expected)
                        (list (cadr expected))))
             (canonical (if (eq? kind 'media) (car mimes) (car mimes))))
        (when (dangerous-mime? mime)
          (fail 'unsupported-media-type "This MIME type is not allowed"))
        (unless (or (string-null? mime)
                    (equal? mime "application/octet-stream")
                    (member mime mimes))
          (fail 'mime-mismatch "MIME type does not match the uploaded filename"))
        (if (and (string-null? mime) (eq? kind 'media))
            (if (string=? extension ".webm") "video/webm" canonical)
            (if (string-null? mime) canonical mime)))))))

(define (detected-asset-type extension mime)
  (let ((expected (expected-media extension)))
    (cond
     ((not expected) "other")
     ((eq? (car expected) 'media) (if (string-prefix? "audio/" mime) "audio" "video"))
     ((eq? (car expected) 'image) "image")
     ((eq? (car expected) 'audio) "audio")
     ((eq? (car expected) 'video) "video")
     (else "document"))))

(define (studio-asset-validate-upload config filename mime bytes requested-type)
  (let* ((original (safe-original-filename filename))
         (extension (lower-extension original))
         (_ (unless (safe-extension extension)
              (fail 'invalid-filename "Upload extension is invalid")))
         (size (bytevector-length bytes))
         (mime* (normalize-mime mime))
         (mime** (validate-mime extension mime*))
         (expected (expected-media extension))
         (magic (and expected (caddr expected)))
         (asset-type (detected-asset-type extension mime**)))
    (when (= size 0)
      (fail 'empty-file "Uploaded file is empty"))
    (when (> size (studio-asset-max-bytes config))
      (fail 'file-too-large "Uploaded file exceeds the Studio asset limit"))
    (when (and expected magic (not (magic-matches? magic bytes)))
      (fail 'invalid-content "Uploaded content does not match its declared media type"))
    (when (and requested-type (not (string-null? requested-type))
               (not (equal? requested-type asset-type)))
      (fail 'type-mismatch "asset_type does not match the uploaded file"))
    `((asset_type . ,asset-type)
      (original_filename . ,original)
      (mime_type . ,mime**)
      (file_size . ,size)
      (extension . ,extension))))

(define (studio-asset-storage-key asset-id extension)
  (unless (safe-component? asset-id)
    (fail 'invalid-storage-key "Asset storage key is invalid"))
  (let ((extension (or (safe-extension extension) "")))
    (string-append asset-id extension)))

(define (sha256-file path)
  (let* ((pipe (open-pipe* OPEN_READ "sha256sum" path))
         (line (read-line pipe))
         (status (close-pipe pipe)))
    (unless (and (zero? status) line (>= (string-length line) 64))
      (fail 'checksum-failed "Could not calculate the Asset checksum"))
    (substring line 0 64)))

(define (studio-asset-store-file! config storage-key bytes)
  (unless (and (safe-component? storage-key)
               (not (string-prefix? "." storage-key)))
    (fail 'invalid-storage-key "Asset storage key is invalid"))
  (let* ((root (asset-root config))
         (final (string-append root "/" storage-key))
         (temporary (string-append root "/.upload-"
                                   (number->string (current-time)) "-"
                                   (number->string (random 1000000)) ".tmp"))
         (checksum #f))
    (ensure-directory root)
    (when (file-exists? final)
      (fail 'storage-collision "Asset storage collision"))
    (catch #t
      (lambda ()
        (call-with-output-file temporary
          (lambda (port) (put-bytevector port bytes)))
        (set! checksum (sha256-file temporary))
        (rename-file temporary final)
        checksum)
      (lambda (key . args)
        (when (file-exists? temporary) (delete-file temporary))
        (apply throw key args)))))

(define (studio-asset-resolve-path config storage-key)
  (and (string? storage-key) (not (string-null? storage-key)) (safe-component? storage-key)
       (let* ((root0 (asset-root config))
              (root (and (file-exists? root0)
                         (catch #t (lambda () (canonicalize-path root0))
                           (lambda _ #f))))
              (candidate (and root
                              (catch #t
                                (lambda () (canonicalize-path (string-append root "/" storage-key)))
                                (lambda _ #f))))
              (prefix (and root (string-append root "/"))))
         (and candidate prefix (file-exists? candidate)
              (not (file-is-directory? candidate))
              (string-prefix? prefix candidate)
              candidate))))

(define (studio-asset-delete-file! config storage-key)
  (let ((path (studio-asset-resolve-path config storage-key)))
    (when path
      (catch #t (lambda () (delete-file path) #t) (lambda _ #f)))))
