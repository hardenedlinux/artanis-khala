(define-module (khala comfy lower)
  #:use-module (srfi srfi-1)
  #:export (lower-workflow))

(define (value object key . default)
  (let ((entry (and (list? object) (assoc key object))))
    (if entry (cdr entry) (if (null? default) #f (car default)))))

(define (find-class nodes class)
  (find (lambda (node) (equal? class (value (cdr node) "class_type"))) nodes))

(define (node-input node key . default)
  (let ((inputs (value (cdr node) "inputs" '())))
    (value inputs key (if (null? default) #f (car default)))))

(define (topological-node-ids nodes)
  (let ((seen '()) (result '()))
    (define (visit id)
      (unless (member id seen)
        (set! seen (cons id seen))
        (let ((node (assoc id nodes)))
          (when node
            (let ((inputs (value (cdr node) "inputs" '())))
              (for-each
               (lambda (entry)
                 (let* ((connection (cdr entry))
                        (link (cond ((and (vector? connection)
                                          (>= (vector-length connection) 2))
                                     (vector-ref connection 0))
                                    ((and (list? connection) (>= (length connection) 2))
                                     (car connection))
                                    (else #f))))
                   (when (and (string? link) (assoc link nodes))
                     (visit link))))
               inputs)))
          (set! result (append result (list id))))))
    ;; Guile's JSON object decoder returns object fields in reverse input order.
    (for-each (lambda (node) (visit (car node))) (reverse nodes))
    result))

(define (lower-workflow prompt)
  (let* ((nodes prompt)
         (checkpoint (find-class nodes "CheckpointLoaderSimple"))
         (unet (find-class nodes "UNETLoader"))
         (clip (or (find-class nodes "DualCLIPLoader")
                   (find-class nodes "CLIPLoader")))
         (vae (or checkpoint (find-class nodes "VAELoader")))
         (positive (find-class nodes "CLIPTextEncode"))
         (negative (and positive
                        (find (lambda (node)
                                (not (equal? (car node) (car positive))))
                              (filter (lambda (node)
                                        (equal? "CLIPTextEncode"
                                               (value (cdr node) "class_type")))
                                      nodes))))
         (latent (or (find-class nodes "EmptyLatentImage")
                     (find-class nodes "EmptyImage")))
         (sampler (find-class nodes "KSampler"))
         (decode (find-class nodes "VAEDecode"))
         (save (or (find-class nodes "SaveImage")
                   (find-class nodes "PreviewImage")))
         (valid? (or (and checkpoint positive negative latent sampler decode save)
                     (and unet clip vae positive negative latent sampler decode save)
                     (and (find-class nodes "EmptyImage") save))))
    (if (not valid?)
        (values #f #f)
        (values
         (list (cons 'model (or (and checkpoint (node-input checkpoint "ckpt_name"))
                                (and unet (node-input unet "unet_name"))))
               (cons 'positive (if positive (node-input positive "text" "") ""))
               (cons 'negative (if negative (node-input negative "text" "") ""))
               (cons 'width (or (and latent (node-input latent "width")) 512))
               (cons 'height (or (and latent (node-input latent "height")) 512))
               (cons 'batch_size (or (and latent (node-input latent "batch_size")) 1))
               (cons 'seed (or (and sampler (node-input sampler "seed")) 0))
               (cons 'steps (or (and sampler (node-input sampler "steps")) 1))
               (cons 'cfg (or (and sampler (node-input sampler "cfg")) 1.0))
               (cons 'sampler_name (and sampler (node-input sampler "sampler_name")))
               (cons 'scheduler (and sampler (node-input sampler "scheduler")))
               (cons 'denoise (and sampler (node-input sampler "denoise")))
               (cons 'filename_prefix (if save (node-input save "filename_prefix" "ComfyUI") "ComfyUI")))
         (topological-node-ids nodes)))))
