(define-module (khala comfy routes)
  #:use-module (artanis artanis)
  #:use-module (artanis route)
  #:use-module (artanis websocket)
  #:use-module (json)
  #:use-module (rnrs io ports)
  #:use-module (rnrs bytevectors)
  #:use-module (ice-9 rdelim)
  #:use-module (khala config)
  #:use-module (khala json)
  #:use-module (khala models)
  #:use-module (khala comfy files)
  #:use-module (khala comfy object-info)
  #:use-module (khala comfy queue)
  #:use-module (khala comfy history)
  #:use-module (khala comfy validate)
  #:use-module (khala comfy ws)
  #:use-module (khala comfy persistence-api)
  #:use-module (srfi srfi-1)
  #:export (register-routes! restore-persisted-queue!))

(define (reply value)
  (response-emit (if (string? value) value (json-encode value))
                 #:headers '((content-type . (application/json (charset . "utf-8"))))))
(define (obj . fields) (make-json-object fields))
(define prompt-counter 0)
(define (new-prompt-id)
  (call-with-input-file "/proc/sys/kernel/random/uuid" read-line))

(define (queue-render item)
  (if item
      (list (assq-ref item 'number) (assq-ref item 'prompt_id)
            (json-normalize (assq-ref item 'prompt))
            (make-json-object
             (list (cons "client_id" (or (assq-ref item 'client_id) 'null)))))
      '()))

(define (restore-persisted-queue! config)
  (for-each
   (lambda (item)
     (set! prompt-counter (max prompt-counter (assq-ref item 'number)))
     (queue-submit! item))
   (or (persistence-call config 'fetch-pending-queue) '())))

(define (all-history config)
  (let ((memory (history-all))
        (stored (or (persistence-call config 'fetch-all-history!) '())))
    (append memory (filter (lambda (entry) (not (assoc (car entry) memory))) stored))))

(define (register-routes! config)
  (define (install prefix)
    (define (route path handler) (get (string-append prefix path) handler))
    (route "/object_info" (lambda _ (reply (make-json-object (object-info config)))))
    (route "/object_info/:node" (lambda (rc)
                                    (reply (make-json-object
                                            (object-info config (params rc "node"))))))
    (get (string-append prefix "/ws") #:websocket 'raw
         (lambda (rc)
           (let ((sid (or (params rc "clientId") (new-prompt-id))))
             (ws-dispatcher
              #:on-open
              (lambda (connection)
                (catch #t
                  (lambda ()
                    (ws-register! sid connection)
                    (ws-send connection
                      (json-encode
                       (obj (cons "type" "status")
                            (cons "data"
                                  (obj (cons "status"
                                             (obj (cons "exec_info"
                                                        (obj (cons "queue_remaining"
                                                                   (length (queue-list)))))))
                                       (cons "sid" sid)))))))
                  (lambda (key . args)
                    (format (current-error-port) "Khala WebSocket open error: ~s ~s~%"
                            key args)
                    (apply throw key args))))
              #:on-message (lambda (_connection _message) #t)
              #:on-close (lambda (_connection _code _reason)
                           (ws-unregister! sid))))))
    (route "/models" (lambda _ (reply model-folders)))
    (for-each
     (lambda (folder)
       (route (string-append "/models/" folder)
              (lambda _ (reply (model-files config folder))))
       (route (string-append "/models-type/" folder)
              (lambda _ (reply (model-files config folder)))))
     model-folders)
    (route "/users" (lambda _ (reply (obj (cons "users" '()) (cons "default_user" "khala")))))
    (route "/settings" (lambda _ (reply (obj))))
    (route "/extensions" (lambda _ (reply '())))
    (route "/embeddings" (lambda _ (reply '())))
    (route "/system_stats" (lambda _ (reply (obj (cons "system" (obj))
                                                   (cons "devices" '())))))
    (route "/queue" (lambda _ (reply (obj
                          (cons "queue_running" (if (queue-current)
                                                    (list (queue-render (queue-current))) '()))
                          (cons "queue_pending" (map queue-render (queue-list)))))))
    (route "/history"
           (lambda _ (reply (make-json-object (all-history config)))))
    (route "/history/:prompt_id"
           (lambda (rc)
             (let* ((id (params rc "prompt_id"))
                    (record (or (history-ref id)
                                (persistence-call config 'fetch-history id))))
               (reply (if record
                          (make-json-object (list (cons id record)))
                          (obj))))))
    (route "/" (lambda _
                  (let ((index "vendor/comfyui-frontend/index.html"))
                    (if (file-exists? index)
                        (response-emit (call-with-input-file index get-bytevector-all)
                                       #:headers '((content-type . (text/html (charset . "utf-8")))))
                        (response-emit "ComfyUI-compatible Khala server")))))
    (when (string-null? prefix)
      (route "/user.css" (lambda _ (response-emit "" #:headers '((content-type . (text/css))))))
      (route "/materialdesignicons.min.css"
             (lambda _ (response-emit "" #:headers '((content-type . (text/css))))))
      (route "/api/userdata/user.css"
             (lambda _ (response-emit "" #:headers '((content-type . (text/css)))))))
    (post (string-append prefix "/prompt")
          (lambda (rc)
            (let* ((body (rc-body rc))
                   (request (and body (json-string->scm (utf8->string body))))
                   (prompt-pair (and (list? request) (assoc "prompt" request)))
                   (prompt (and prompt-pair (cdr prompt-pair))))
              (if (not prompt)
                  (reply (obj (cons "error" (obj
                               (cons "type" "no_prompt")
                               (cons "message" "No prompt provided")
                               (cons "details" "No prompt provided")
                               (cons "extra_info" (obj))))
                             (cons "node_errors" (obj))))
                  (call-with-values
                      (lambda () (validate-prompt config prompt))
                    (lambda (valid? details)
                      (if (not valid?)
                          (reply details)
                          (let* ((id (new-prompt-id))
                                 (client (and (assoc "client_id" request)
                                              (cdr (assoc "client_id" request)))))
                            (set! prompt-counter (+ prompt-counter 1))
                            (let* ((extra (or (and (assoc "extra_data" request)
                                                   (cdr (assoc "extra_data" request))) '()))
                                   (item `((prompt_id . ,id)
                                           (number . ,prompt-counter)
                                           (client_id . ,client)
                                           (extra_data . ,extra)
                                           (prompt . ,prompt)))
                                   (front? (eq? #t (and (assoc "front" request)
                                                       (cdr (assoc "front" request))))))
                              (persistence-call config 'save-queue-item! item front?)
                              (queue-submit! item front?))
                            (reply (obj (cons "prompt_id" id)
                                        (cons "number" prompt-counter)
                                        (cons "node_errors" (obj))))))))))))
    (post (string-append prefix "/queue")
          (lambda _ (queue-clear!)
            (persistence-call config 'clear-persisted-queue!) (reply (obj))))
    (page-delete (string-append prefix "/queue")
                 (lambda _ (queue-clear!)
                   (persistence-call config 'clear-persisted-queue!) (reply (obj))))
    (route "/interrupt" (lambda _ (queue-interrupt!) (reply (obj))))
    (post (string-append prefix "/interrupt")
          (lambda _ (queue-interrupt!) (reply (obj))))
    (route "/view"
           (lambda (rc)
             (let ((path (view-path config (params rc "filename")
                                   (params rc "subfolder") (params rc "type"))))
               (if path
                   (response-emit (call-with-input-file path get-bytevector-all)
                                  #:headers '((content-type . (image/png))))
                   (response-emit "Not found" #:status 404)))))
    (route "/upload/image" (lambda _ (response-emit "Upload body parser unavailable" #:status 501)))
    (route "/upload/mask" (lambda _ (response-emit "Upload body parser unavailable" #:status 501))))
  (install "")
  (install "/api"))
