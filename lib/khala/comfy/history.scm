(define-module (khala comfy history)
  #:use-module (ice-9 threads)
  #:use-module (srfi srfi-1)
  #:export (history-add! history-ref history-list history-all history-clear!))

(define lock (make-mutex))
(define entries '())
(define (history-add! id value)
  (with-mutex lock
    (set! entries (acons id value (alist-delete id entries)))
    value))
(define (history-ref id)
  (with-mutex lock (assoc-ref entries id)))
(define (history-list)
  (with-mutex lock (map cdr entries)))
(define (history-all)
  (with-mutex lock (append '() entries)))
(define (history-clear!)
  (with-mutex lock (set! entries '())))
